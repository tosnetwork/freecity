{
  "name": "freecity",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @freecity/web dev",
    "db:migrate": "node-pg-migrate -m migrations --migrations-schema public up",
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "node-pg-migrate": "^7.9.0",
    "pg": "^8.13.1",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
